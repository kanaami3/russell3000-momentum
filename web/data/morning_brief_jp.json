try_high": 1850, "stop": 1780, "target_today": 1920, "target_next": 2000}, {"ticker": "7581.T", "name": "サイゼリヤ", "type": "順張り(続伸)", "hold_horizon": "翌日持越し可", "rationale": "前日+7.63%上昇、出来高5.8倍と強い買戻しが入る。RSI58と過熱感なく、売買代金243.8億円と流動性も良好。ディフェンシブ内需株としての買戻し需要が高まっており、逆風相場でも安定した右肩上がりのトレンド継続が見込まれる。", "entry": "寄付後の押し目 6,980〜7,030円付近", "target": "本日 7,250円 / 翌日 7,400円", "risk": "6,880円下抜けで撤退", "entry_low": 6980, "entry_high": 7030, "stop": 6880, "target_today": 7250, "target_next": 7400}, {"ticker": "6857.T", "name": "アドバンテスト", "type": "逆張り(売られすぎ反発)", "hold_horizon": "日中決済", "rationale": "SOX指数4.30%安を受け大幅ギャップダウン必至だが、売買代金9,548.1億円と市場最高の流動性を誇る。寄り付き直後の過剰な売り一巡後は、デイトレードのショートカバーや押し目買いによる急反発が狙える。日中決済に限定。", "entry": "ギャップダウン後の下値見極め 32,500〜33,000円付近", "target": "本日 34,200円", "risk": "32,000円割れで即時損切り", "entry_low": 32500, "entry_high": 33000, "stop": 32000, "target_today": 34200, "target_next": null}, {"ticker": "7599.T", "name": "ＩＤＯＭ", "type": "逆張り(売られすぎ反発)", "hold_horizon": "日中決済", "rationale": "前日-20.07%と暴落し、RSI15と極端な売られ過ぎ水準に到達。出来高は6.6倍、売買代金66.6億円と商いが急増しており、投げ売りが一巡した後の自律反発狙いのデイトレに最適。引き付けた逆張りに特化。", "entry": "寄付き直後の売り一巡 900〜920円付近", "target": "本日 970円", "risk": "880円下抜けで損切り", "entry_low": 900, "entry_high": 920, "stop": 880, "target_today": 970, "target_next": null}, {"ticker": "6920.T", "name": "レーザーテック", "type": "逆張り(売られすぎ反発)", "hold_horizon": "日中決済", "rationale": "前日-13.56%に続き米半導体安の煽りで寄り付きは強い売り先行が見込まれる。しかし売買代金3,066.6億円の圧倒的な流動性があり、値幅制限近くまでの売り先行後は個人・機関の買い戻しが入りやすい。引け前決済を徹底。", "entry": "売り気配通過後の初原変化 37,000〜37,500円付近", "target": "本日 38,800円", "risk": "36,400円割れで撤退", "entry_low": 37000, "entry_high": 37500, "stop": 36400, "target_today": 38800, "target_next": null}], "ai_brief_model": "claude-haiku-4-5-20251001"}